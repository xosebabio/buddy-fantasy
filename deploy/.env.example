# Production configuration. Copy to /opt/buddy-fantasy/.env on the server (chmod 600) and fill in the real
# values there. Never commit the real file: the repository and the images are public.

# Image tag of the three images; the deploy job writes it (sha-<7> of the commit, or latest)
IMAGE_TAG=latest

# PostgreSQL
DB_NAME=buddyfantasy
DB_USER=buddyfantasy
DB_PASSWORD=change-me

# Google OAuth client; the redirect URI is https://<SITE_ADDRESS>/login/oauth2/code/google
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me

# Domain Caddy serves (automatic HTTPS)
SITE_ADDRESS=buddyfantasy.com

# Backups (RNF-07): encrypted pg_dump to a private S3 bucket. The IAM user can only s3:PutObject (backup/iam-policy.json)
# and BACKUP_AGE_RECIPIENT is the age public key; the private key never goes on the server.
BACKUP_S3_BUCKET=change-me
BACKUP_S3_REGION=eu-west-1
BACKUP_AWS_ACCESS_KEY_ID=change-me
BACKUP_AWS_SECRET_ACCESS_KEY=change-me
BACKUP_AGE_RECIPIENT=age1change-me
